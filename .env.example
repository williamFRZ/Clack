# Copie para .env e escolha duas senhas diferentes, com pelo menos 20 caracteres.
# Para evitar interpretacao do Compose, use letras e numeros nas senhas abaixo.
CLACK_DB_PASSWORD=
CLACK_DB_ROOT_PASSWORD=

# Acesso somente neste computador. Para demonstracao com ESP32 na LAN: 0.0.0.0.
CLACK_BIND_IP=127.0.0.1
CLACK_PORT=8080
